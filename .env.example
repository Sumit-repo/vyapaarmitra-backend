# Copy to .env for local runs (never commit .env).
# On Cloud Run, set these as service environment variables / secrets.

# Supabase used as plain Postgres. Find host/password in Supabase project settings.
DATABASE_URL=jdbc:postgresql://db.YOUR_PROJECT.supabase.co:5432/postgres
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your-db-password

# HMAC secret for JWT signing. Generate: openssl rand -base64 48 (min 32 bytes).
JWT_SECRET=change-me-to-a-long-random-secret-min-32-chars
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=30

# Comma-separated origins for the web dashboard.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Google sign-in: comma-separated accepted OAuth client IDs (audiences) — the Web
# client ID, plus the iOS client ID if used. Not a secret. Blank disables Google.
# See docs/GOOGLE_OAUTH_SETUP.md.
GOOGLE_CLIENT_IDS=

# Email OTP delivery via Resend. Blank RESEND_API_KEY logs codes instead of sending.
# MAIL_FROM domain must be verified in the Resend account.
RESEND_API_KEY=
MAIL_FROM=VyapaarMitra <noreply@example.com>
OTP_TTL_MINUTES=10

# First-boot seeding (only runs when the users table is empty).
BOOTSTRAP_OWNER_EMAIL=owner@example.com
BOOTSTRAP_OWNER_PASSWORD=change-me-strong-password
BOOTSTRAP_OWNER_NAME=Sumit Kumar
BOOTSTRAP_BUSINESS_NAME=Uma Xerox & General Store
BOOTSTRAP_BRANCH_NAME=Main Branch

# Optional
APP_TIMEZONE=Asia/Kolkata
DB_POOL_SIZE=5
